	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/dynamic_lighting/help_strings">
		<string text=""/>
		<string text="Plasma, rockets and Covenant projectiles cast\nsoft light on nearby surfaces and models."/>
		<string text="Weapon flashes light nearby surfaces, including\nthe Warthog turret. Stock flash effects remain."/>
		<string text="Jackal shields light their surroundings,\nmatching their colour and damage flashes."/>
		<string text="Covenant stationary shields cast coloured light\nthat follows damage flashes and shield strength."/>
		<string text="Exposed fuel rods on a held Grunt cannon cast\ngreen light on the holder and nearby surfaces."/>
		<string text="The AR ammo screen glows and lights the weapon\nand holder in first and third person."/>
		<string text="Exposed needles glow and spill light around the\nheld weapon, with a soft fade below it."/>
		<string text="Block added light behind walls and doors, and\nWarthog muzzle light through vehicle bodies."/>
	</strings>
