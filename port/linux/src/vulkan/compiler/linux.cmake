# The optional compiler uses the same Debian 11 glibc baseline as the game.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET i686-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET i686-linux-gnu)
set(CMAKE_SYSROOT "${HALO_SYSROOT}")
set(CMAKE_LIBRARY_ARCHITECTURE i386-linux-gnu)
set(CMAKE_C_FLAGS_INIT "-m32 --gcc-toolchain=\"${HALO_SYSROOT}/usr\"")
set(CMAKE_CXX_FLAGS_INIT "-m32 --gcc-toolchain=\"${HALO_SYSROOT}/usr\" -nostdinc++ -isystem \"${HALO_SYSROOT}/usr/include/c++/10\" -isystem \"${HALO_SYSROOT}/usr/include/i386-linux-gnu/c++/10\" -isystem \"${HALO_SYSROOT}/usr/include/c++/10/backward\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -static-libstdc++ -static-libgcc")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld -static-libstdc++ -static-libgcc -Wl,--exclude-libs,ALL")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES HALO_SYSROOT)
