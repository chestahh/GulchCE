/* Local lights compare radial distances. The orthographic sun compares
   reversed depth, swapping the operands of the same visibility test. */
static const char shadow_filter[] =
    "float shadow_visible(float receiver, float blocker) { return step(receiver,blocker); }\n"
    "float shadow_filter4(vec4 samples, vec2 f) {\n"
    "    return mix(mix(samples.x,samples.y,f.x),mix(samples.z,samples.w,f.x),f.y);\n"
    "}\n";

/* Both projections evaluate the same continuous light-space distance at the
   receiver. The outer edge leaves room for half a cache-grid step. */
static const char sun_coverage[] =
    "uniform vec4 sun_region[4];\n"
    "vec2 sun_weights(vec3 world) {\n"
    "    vec4 p=vec4(world,1);\n"
    "    vec2 near_xy=vec2(dot(p,sun_region[0]),dot(p,sun_region[1]));\n"
    "    float near_w=1.-smoothstep(.60,.925,max(abs(near_xy.x),abs(near_xy.y)));\n"
    "    if(sun_region[2].z>=1.)return vec2(near_w,0.);\n"
    "    vec2 far_xy=abs(near_xy+sun_region[3].xy)*sun_region[2].z;\n"
    "    float far_w=1.-smoothstep(.60,.925,max(far_xy.x,far_xy.y));\n"
    "    return vec2(near_w,(1.-near_w)*far_w);\n"
    "}\n"
    "float sun_fallback(vec3 world) { return 1.-dot(sun_weights(world),vec2(1.)); }\n";

/* RGB adds exposed sunlight. Alpha attenuates baked light only where a posed
   object blocks a ray that the BSP alone leaves open. Separate object and
   receiver meshes do not need the self-shadow depth bias used on models.
   The fine region concentrates posed depth around nearby receivers. Blend
   visibility at its rim before applying the sun contribution once.
   Gather at the centre of the selected four texels so hardware rounding
   cannot shift the reads away from the four expected plane depths. */
static const char sun_lighting[] =
    "uniform mat4 sun_frame;\n"
    "uniform vec4 sun_color_radius;\n"
    "uniform int sun_soft;\n"
    "uniform vec4 sun_detail; uniform vec4 sun_eye, sun_close;\n"
    "uniform sampler2D sun_bsp, sun_objects, sun_far_bsp, sun_far_objects;\n"
    "#ifdef SUN\n"
    "float sun_resolve_bias(vec2 gradient,float view_depth);\n"
    "#endif\n"
    "float sun_tile_visibility(vec2 local,float scale,int tile,float depth,vec2 gradient,ivec2 size,bool bsp) {\n"
    "    vec2 pos=local*vec2(size)-.5, slope=gradient/(scale*vec2(size));\n"
    "    float bias=bsp?2.e-7:.0001; ivec2 offset=ivec2(tile*size.x,0);\n"
    "    if (sun_soft==0) {\n"
    "        ivec2 cell=ivec2(floor(pos+.5));\n"
    "        float expected=depth+dot(vec2(cell)-pos,slope);\n"
    "        return step(texelFetch(sun_objects,offset+cell,0).r,expected+bias);\n"
    "    }\n"
    "    vec2 f=fract(pos);\n"
    "    vec4 expected=(depth+bias-dot(f,slope))+vec4(0,slope.x,slope.y,slope.x+slope.y);\n"
    "#if __VERSION__ >= 400 || defined(SUN_GATHER)\n"
    "    vec2 gather_uv=(floor(pos)+1.+vec2(offset))/vec2(size);\n"
    "    vec4 objects=textureGather(sun_objects,gather_uv*vec2(sun_detail.w,1.)).wzxy;\n"
    "#else\n"
    "    ivec2 base=offset+ivec2(floor(pos));\n"
    "    vec4 objects=vec4(texelFetch(sun_objects,base,0).r,texelFetch(sun_objects,base+ivec2(1,0),0).r,\n"
    "                      texelFetch(sun_objects,base+ivec2(0,1),0).r,texelFetch(sun_objects,base+1,0).r);\n"
    "#endif\n"
    "    return shadow_filter4(step(objects,expected),f);\n"
    "}\n"
    "vec2 sun_detail_visibility(vec3 world,vec2 uv,float depth,vec2 gradient,ivec2 size,bool bsp) {\n"
    "    vec2 close_uv=(uv-sun_close.xy)*sun_close.z+.5;\n"
    "    float rim=max(abs(close_uv.x-.5),abs(close_uv.y-.5));\n"
    "    float close_weight=sun_close.z>0.?sun_close.w*(1.-smoothstep(.43,.49,rim)):0.;\n"
    "    float close_lit=0.; if(close_weight>0.) close_lit=sun_tile_visibility(close_uv,sun_close.z,2,depth,gradient,size,bsp);\n"
    "    if(close_weight>=1.)return vec2(1.,close_lit);\n"
    "    vec2 local=(uv-sun_detail.xy)*sun_detail.z+.5; vec3 delta=world-sun_eye.xyz;\n"
    "    float d2=dot(delta,delta)*sun_eye.w, radial_weight=0., radial_lit=0.;\n"
    "    if(sun_detail.z>0. && d2<1. && all(lessThan(abs(local-.5),vec2(.495)))) {\n"
    "        radial_weight=(1.-smoothstep(.765625,1.,d2))*(1.-close_weight);\n"
    "        radial_lit=sun_tile_visibility(local,sun_detail.z,1,depth,gradient,size,bsp); }\n"
    "    float w=radial_weight+close_weight; return vec2(w,(radial_weight*radial_lit+close_weight*close_lit)/max(w,1.e-8));}\n"
    "vec2 sun_sample(float ground, float object_depth, float expected, float static_bias, bool bsp, vec2 detail) {\n"
    "    float static_lit=shadow_visible(abs(ground),expected+static_bias);\n"
    "    float object_lit=shadow_visible(object_depth,expected+(bsp?2.e-7:.0001));\n"
    "    object_lit=mix(object_lit,detail.y,detail.x);\n"
    "    return vec2(static_lit*object_lit,ground>0.?static_lit*(1.-object_lit):0.);\n"
    "}\n"
    "vec2 sun_tap(sampler2D ground_map,sampler2D objects_map,ivec2 cell, ivec2 size, vec2 uv, float depth, vec2 gradient, float static_bias, bool bsp, vec2 detail) {\n"
    "    if (any(lessThan(cell,ivec2(0))) || any(greaterThanEqual(cell,size))) return vec2(0);\n"
    "    float expected=depth+dot((vec2(cell)+.5)/vec2(size)-uv,gradient);\n"
    "    return sun_sample(texelFetch(ground_map,cell,0).r,texelFetch(objects_map,cell,0).r,expected,static_bias,bsp,detail);\n"
    "}\n"
    "vec2 sun_visibility(sampler2D ground_map,sampler2D objects_map,float atlas_scale,vec2 uv,float depth,vec2 gradient,float static_bias,bool bsp,vec2 detail) {\n"
    "    ivec2 size=textureSize(ground_map,0), cell=ivec2(floor(uv*vec2(size)));\n"
    "    vec2 visibility;\n"
    "    if (sun_soft==0) {\n"
    "        float ground=texelFetch(ground_map,cell,0).r;\n"
    "        if (bsp && ground<=0.) return vec2(0);\n"
    "        float expected=depth+dot((vec2(cell)+.5)/vec2(size)-uv,gradient);\n"
    "        visibility=sun_sample(ground,texelFetch(objects_map,cell,0).r,expected,static_bias,bsp,detail);\n"
    "    }\n"
    "    else {\n"
    "        vec2 pos=uv*vec2(size)-.5, f=fract(pos);\n"
    "        ivec2 base=ivec2(floor(pos));\n"
    "#if __VERSION__ >= 400 || defined(SUN_GATHER)\n"
    "        vec2 gather_uv=(vec2(base)+1.)/vec2(size);\n"
    "        vec4 ground=textureGather(ground_map,gather_uv).wzxy;\n"
    "        if (bsp && ground[int(f.x>=.5)+2*int(f.y>=.5)]<=0.) return vec2(0);\n"
    "        vec4 objects=textureGather(objects_map,gather_uv*vec2(atlas_scale,1.)).wzxy;\n"
    "        vec2 slope=gradient/vec2(size);\n"
    "        vec4 expected=(depth-dot(f,slope))+vec4(0,slope.x,slope.y,slope.x+slope.y);\n"
    "        vec4 static_lit=step(abs(ground),expected+static_bias);\n"
    "        if (base.x<0) static_lit.xz=vec2(0); if (base.x+1>=size.x) static_lit.yw=vec2(0);\n"
    "        if (base.y<0) static_lit.xy=vec2(0); if (base.y+1>=size.y) static_lit.zw=vec2(0);\n"
    "        vec4 object_lit=step(objects,expected+(bsp?2.e-7:.0001));\n"
    "        object_lit=mix(object_lit,vec4(detail.y),detail.x);\n"
    "        visibility=vec2(shadow_filter4(static_lit*object_lit,f),\n"
    "            shadow_filter4(static_lit*(1.-object_lit)*vec4(greaterThan(ground,vec4(0))),f));\n"
    "#else\n"
    "        if (bsp && texelFetch(ground_map,cell,0).r<=0.) return vec2(0);\n"
    "        visibility=mix(mix(sun_tap(ground_map,objects_map,base,size,uv,depth,gradient,static_bias,bsp,detail),sun_tap(ground_map,objects_map,base+ivec2(1,0),size,uv,depth,gradient,static_bias,bsp,detail),f.x),\n"
    "            mix(sun_tap(ground_map,objects_map,base+ivec2(0,1),size,uv,depth,gradient,static_bias,bsp,detail),sun_tap(ground_map,objects_map,base+1,size,uv,depth,gradient,static_bias,bsp,detail),f.x),f.y);\n"
    "#endif\n"
    "    }\n"
    "    return visibility;\n"
    "}\n"
    "vec4 sun_light(vec3 world, vec3 normal, bool bsp, float view_depth) {\n"
    "    if (sun_color_radius.w <= 0.) return vec4(0);\n"
    "    vec3 q = transpose(mat3(sun_frame))*(world-sun_frame[3].xyz)/sun_color_radius.w;\n"
    "    vec2 uv = q.xy*.5+.5;\n"
    "    float depth = .5-.5*q.z;\n"
    "    vec3 dx=dFdx(vec3(uv,depth)), dy=dFdy(vec3(uv,depth));\n"
    "    float det=dx.x*dy.y-dx.y*dy.x;\n"
    "    vec2 gradient=abs(det)>1.e-12?vec2(dx.z*dy.y-dy.z*dx.y,dx.x*dy.z-dy.x*dx.z)/det:vec2(0);\n"
    "    if (abs(q.z)>=1.) return vec4(0);\n"
    "    float facing=max(dot(normal,-normalize(sun_frame[2].xyz)),0.);\n"
    "    vec2 weights=sun_weights(world);\n"
    "    if ((weights.x+weights.y)<=0. || facing<=0.) return vec4(0);\n"
    "    float static_bias=.0001;\n"
    "#ifdef SUN\n"
    "    static_bias+=sun_resolve_bias(gradient,view_depth);\n"
    "#endif\n"
    "    vec2 visibility=vec2(0.);\n"
    "    if (weights.x>0.) {\n"
    "        vec2 detail=sun_detail_visibility(world,uv,depth,gradient,textureSize(sun_bsp,0),bsp);\n"
    "        visibility=weights.x*sun_visibility(sun_bsp,sun_objects,sun_detail.w,uv,depth,gradient,static_bias,bsp,detail);\n"
    "    }\n"
    "    if (weights.y>0.) {\n"
    "        vec2 far_uv=(uv-sun_region[2].xy)*sun_region[2].z+.5;\n"
    "        vec2 far_lit=sun_visibility(sun_far_bsp,sun_far_objects,1.,far_uv,depth,gradient/sun_region[2].z,static_bias,bsp,vec2(0.));\n"
    "        visibility+=weights.y*far_lit;\n"
    "    }\n"
    "    vec3 direct=sun_color_radius.rgb*facing;\n"
    "    return vec4(direct*visibility.x,dot(direct,vec3(.2126,.7152,.0722))*visibility.y);\n"
    "}\n";
