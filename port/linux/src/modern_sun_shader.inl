/* Local lights compare radial distances. The orthographic sun compares
   reversed depth, swapping the operands of the same visibility test. */
static const char shadow_filter[] =
    "float shadow_visible(float receiver, float blocker) { return step(receiver,blocker); }\n"
    "float shadow_filter4(vec4 samples, vec2 f) {\n"
    "    return mix(mix(samples.x,samples.y,f.x),mix(samples.z,samples.w,f.x),f.y);\n"
    "}\n";

static const char sun_lighting[] =
    "uniform mat4 sun_frame;\n"
    "uniform vec4 sun_color_radius;\n"
    "uniform int sun_soft;\n"
    "uniform sampler2D sun_bsp, sun_objects;\n"
    "float sun_tap(ivec2 cell, ivec2 size, vec2 uv, float depth, vec2 gradient) {\n"
    "    if (any(lessThan(cell,ivec2(0))) || any(greaterThanEqual(cell,size))) return 0.;\n"
    "    float expected = depth + dot((vec2(cell)+.5)/vec2(size)-uv,gradient);\n"
    "    float blocker = max(abs(texelFetch(sun_bsp,cell,0).r),texelFetch(sun_objects,cell,0).r);\n"
    "    return shadow_visible(blocker,expected+.0001);\n"
    "}\n"
    "vec3 sun_light(vec3 world, vec3 normal, bool bsp) {\n"
    "    if (sun_color_radius.w <= 0.) return vec3(0);\n"
    "    vec3 q = transpose(mat3(sun_frame))*(world-sun_frame[3].xyz)/sun_color_radius.w;\n"
    "    vec2 uv = q.xy*.5+.5;\n"
    "    float depth = .5-.5*q.z;\n"
    "    vec3 dx=dFdx(vec3(uv,depth)), dy=dFdy(vec3(uv,depth));\n"
    "    float det=dx.x*dy.y-dx.y*dy.x;\n"
    "    vec2 gradient=abs(det)>1.e-12?vec2(dx.z*dy.y-dy.z*dx.y,dx.x*dy.z-dy.x*dx.z)/det:vec2(0);\n"
    "    if (any(greaterThanEqual(abs(q),vec3(1)))) return vec3(0);\n"
    "    ivec2 size=textureSize(sun_bsp,0), cell=ivec2(floor(uv*vec2(size)));\n"
    "    float facing=max(dot(normal,-normalize(sun_frame[2].xyz)),0.);\n"
    "    if (facing<=0.) return vec3(0);\n"
    "    float edge=1.-smoothstep(.9,1.,max(abs(q.x),abs(q.y)));\n"
    "    float lit;\n"
    "    if (sun_soft==0) {\n"
    "        float ground=texelFetch(sun_bsp,cell,0).r;\n"
    "        if (bsp && ground<=0.) return vec3(0);\n"
    "        float expected=depth+dot((vec2(cell)+.5)/vec2(size)-uv,gradient);\n"
    "        lit=shadow_visible(max(abs(ground),texelFetch(sun_objects,cell,0).r),expected+.0001);\n"
    "    }\n"
    "    else {\n"
    "        vec2 pos=uv*vec2(size)-.5;\n"
    "        ivec2 base=ivec2(floor(pos));\n"
    "#if __VERSION__ >= 400 || defined(SUN_GATHER)\n"
    "        vec2 f=fract(pos), slope=gradient/vec2(size);\n"
    "        vec4 ground=textureGather(sun_bsp,uv).wzxy;\n"
    "        if (bsp && ground[int(f.x>=.5)+2*int(f.y>=.5)]<=0.) return vec3(0);\n"
    "        vec4 blocker=max(abs(ground),textureGather(sun_objects,uv).wzxy);\n"
    "        vec4 expected=(depth+.0001-dot(f,slope))+vec4(0,slope.x,slope.y,slope.x+slope.y);\n"
    "        vec4 vis=step(blocker,expected);\n"
    "        if (base.x<0) vis.xz=vec2(0); if (base.x+1>=size.x) vis.yw=vec2(0);\n"
    "        if (base.y<0) vis.xy=vec2(0); if (base.y+1>=size.y) vis.zw=vec2(0);\n"
    "        lit=shadow_filter4(vis,f);\n"
    "#else\n"
    "        if (bsp && texelFetch(sun_bsp,cell,0).r<=0.) return vec3(0);\n"
    "        lit=shadow_filter4(vec4(sun_tap(base,size,uv,depth,gradient),\n"
    "            sun_tap(base+ivec2(1,0),size,uv,depth,gradient),sun_tap(base+ivec2(0,1),size,uv,depth,gradient),\n"
    "            sun_tap(base+1,size,uv,depth,gradient)),fract(pos));\n"
    "#endif\n"
    "    }\n"
    "    return sun_color_radius.rgb*(lit*edge*facing);\n"
    "}\n";
